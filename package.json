{
  "name": "breathe-with-me",
  "productName": "Breathe With Me",
  "version": "1.0.0",
  "description": "A small game for World Mental Health Day.",
  "author": "Dede Rian",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k -n vite,electron \"vite --port 5173 --strictPort\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "build:web": "vite build",
    "dist:win": "npm run build && electron-builder --win",
    "assets": "node scripts/make-assets.mjs"
  },
  "build": {
    "appId": "com.breathewithme.game",
    "productName": "Breathe With Me",
    "copyright": "Copyright (c) 2026 Dede Rian",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!node_modules/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/icon.png",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Breathe With Me",
      "artifactName": "BreatheWithMe-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "BreatheWithMe-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@fontsource/quicksand": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "pixi.js": "^8.21.0",
    "png-to-ico": "^3.0.2",
    "tone": "^15.1.22",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wait-on": "^9.4.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
